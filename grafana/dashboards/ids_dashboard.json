    {
      "id": 38,
      "type": "table",
      "title": "Latest Alerts",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 91
      },
      "description": "Displays the history of real-time alerts populated from the SQLite database.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "SQLite"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "table",
          "rawQueryText": "SELECT timestamp AS Time, src_ip AS \"Source IP\", dst_ip AS \"Destination IP\", attack_type AS Attack, severity AS Severity FROM alerts ORDER BY timestamp DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "High": {
                        "color": "red",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "Medium": {
                        "color": "orange",
                        "index": 1
                      }
