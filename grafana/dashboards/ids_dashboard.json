      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 56
      },
      "description": "Approximation: sums the P95 of feature-extraction and inference latency independently. This is NOT a true end-to-end P95 (percentiles aren't additive across independent stages) — it's an upper-bound estimate. For an exact figure, instrument a single histogram spanning capture-to-alert and query that directly.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum(rate(ids_feature_extraction_latency_ms_bucket[1m])) by (le)) + histogram_quantile(0.95,sum(rate(ids_inference_latency_ms_bucket[1m])) by (le))",
